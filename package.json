{
  "name": "vuon-hoa-yeu-thuong",
  "version": "1.0.0",
  "private": true,
  "description": "Vuon Hoa Yeu Thuong — mot trai nghiem khu vuon hoa 3D sinh dong danh cho ngay 20/10.",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/style.css -o assets/app.css --minify",
    "css:watch": "tailwindcss -i src/style.css -o assets/app.css --watch",
    "start": "node server.mjs",
    "dev": "npm run css && node server.mjs",
    "build": "npm run build:site",
    "build:site": "npm run css && node tools/build-site.mjs",
    "preview": "node server.mjs dist"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "html-to-image": "1.11.13",
    "lucide": "1.59.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3"
  }
}
